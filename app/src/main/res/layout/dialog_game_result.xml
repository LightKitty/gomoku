<?xml version="1.0" encoding="utf-8"?>
<!--
  终局结果浮层的内容卡片：**只有一句结果文案**（如「电脑获胜」）。

  轻量简洁：不要副标题提示、不要比分、不要按钮；
  卡片宽度随文字自适应（wrap_content）并在窗口里居中，不占满屏、不做横幅。
  呈现位置由 GameResultOverlay 决定：挂在独立窗口上、浮动在棋盘中部偏上，
  不参与对局页布局，棋盘不会因为结果出现而位移。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <TextView
        android:id="@+id/result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_m"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnPrimaryContainer"
        tools:text="电脑获胜" />
</com.google.android.material.card.MaterialCardView>
